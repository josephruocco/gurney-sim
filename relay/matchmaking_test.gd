extends "res://protocol_test.gd"
func run() -> void:
	var private_host := await connect_socket()
	private_host.put_packet(var_to_bytes({"op": "create", "version": 1}))
	var private_room := await receive(private_host)
	var first := await connect_socket()
	first.put_packet(var_to_bytes({"op": "match", "version": 1}))
	var a := await receive(first)
	check(a.get("welcome") == 1 and a.get("code") != private_room.get("code"), "Matchmaking must exclude private rooms")
	var second := await connect_socket()
	second.put_packet(var_to_bytes({"op": "match", "version": 1}))
	var b := await receive(second)
	check(b.get("welcome") == 2 and b.get("code") == a.get("code"), "Two queued players must pair")
	await receive(first)
	var third := await connect_socket()
	third.put_packet(var_to_bytes({"op": "match", "version": 1}))
	var c := await receive(third)
	check(c.get("welcome") == 1 and c.get("code") != a.get("code"), "Full pair must not take a third player")
	third.close()
	for tick in 60:
		for ws in sockets: ws.poll()
		await process_frame
	var fourth := await connect_socket()
	fourth.put_packet(var_to_bytes({"op": "match", "version": 1}))
	var d := await receive(fourth)
	check(d.get("welcome") == 1 and d.get("code") != c.get("code"), "Cancelled host must leave matchmaking")
	for ws in sockets: ws.close()
	print("Matchmaking pairing, capacity, private-room isolation and cancellation passed" if !failed else "Matchmaking FAILED")
	quit(1 if failed else 0)
